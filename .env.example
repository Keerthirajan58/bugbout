# Copy to .env and fill in. Every value is optional: phases 0 and 1 (scaffold and
# mutation harness) run with no credentials at all.

# --- Phase 2: agents ---------------------------------------------------------
# https://aistudio.google.com -> "Get API key". No credit card. ~1500 req/day free.
PRECEDENT_GEMINI_API_KEY=

# https://console.groq.com -> "API Keys". No credit card. Absorbs Gemini 429s.
PRECEDENT_GROQ_API_KEY=

# --- Phase 3: corpus mining + vector store -----------------------------------
# https://github.com/settings/personal-access-tokens -> fine-grained token.
# Public repositories, read-only. Lifts the API limit from 60/hr to 5000/hr.
PRECEDENT_GITHUB_TOKEN=

# https://neon.tech -> free project -> pooled connection string.
# Format: postgresql://user:password@host/dbname?sslmode=require
PRECEDENT_DATABASE_URL=

# --- optional overrides ------------------------------------------------------
# PRECEDENT_SANDBOX_BACKEND=subprocess
# PRECEDENT_MAX_PARALLEL_JOBS=4
# PRECEDENT_DATA_DIR=/absolute/path/to/data
