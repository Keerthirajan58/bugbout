__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- node / next.js (phase 4) ---
node_modules/
dashboard/.next/
dashboard/out/
.vercel

